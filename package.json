{
    "name": "mcp-thailaw",
    "version": "0.1.0-dev.9",
    "mcpName": "io.github.phattja/mcp-thailaw",
    "description": "MCP server for Thai law search over OCS Krisdika in Qdrant",
    "license": "MIT",
    "author": "phattja (https://github.com/phattja)",
    "homepage": "https://github.com/phattja/mcp-thailaw",
    "bugs": "https://github.com/phattja/mcp-thailaw/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/phattja/mcp-thailaw"
    },
    "keywords": [
        "mcp",
        "modelcontextprotocol",
        "thai-law",
        "krisdika",
        "qdrant",
        "search",
        "legal",
        "thailand",
        "claude",
        "ai"
    ],
    "type": "module",
    "bin": {
        "mcp-thailaw": "dist/cli.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc && shx chmod +x dist/*.js",
        "start": "node dist/cli.js",
        "watch": "tsc --watch",
        "test": "tsx __tests__/run-all.ts",
        "test:coverage": "c8 --reporter=text --include 'src/**' tsx __tests__/run-all.ts",
        "verify:packed-consumer": "node scripts/verify-packed-consumer.mjs",
        "bootstrap": "npm install && npm run build",
        "inspector": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector node dist/cli.js",
        "lint": "eslint src __tests__ scripts --max-warnings=0",
        "audit:deps": "npm audit --audit-level=moderate",
        "security": "npm run lint && npm run audit:deps",
        "postversion": "TAG=$(node scripts/update-version.js | tail -1) && git add src/version.ts .mcp/server.json && git commit --amend --no-edit && git tag -f $TAG"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "undici": "7.29.0"
    },
    "devDependencies": {
        "@types/node": "22.20.1",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "8.66.0",
        "@typescript-eslint/parser": "8.66.0",
        "c8": "^11.0.0",
        "cross-env": "^10.1.0",
        "eslint": "10.8.0",
        "eslint-plugin-security": "^4.0.0",
        "fast-check": "^4.8.0",
        "shx": "^0.4.0",
        "supertest": "^7.2.2",
        "tsx": "4.23.5",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "hono": ">=4.13.0"
    }
}
